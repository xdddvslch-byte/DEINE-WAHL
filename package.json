{
  "name": "deine-wahl",
  "productName": "DEINE WAHL",
  "version": "0.4.0",
  "private": true,
  "description": "Симулятор етичних дилем для сектору безпеки та оборони: розгалужені сценарії в JSON, бали за трьома осями, груповий режим, SCORM",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "node tools/build.mjs",
    "check": "node tools/build.mjs --check",
    "scorm": "node tools/build.mjs --scorm",
    "serve": "npx --yes http-server -p 8080 -c-1 .",
    "dist:win": "electron-builder --win nsis --x64",
    "portable:win": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "ua.deinewahl.trainer",
    "files": [
      "icon.ico",
      "main.js",
      "app.js",
      "validate.js",
      "scorm.js",
      "fx.js",
      "index.html",
      "style.css",
      "fonts.css",
      "data/**/*",
      "assets/**/*",
      "!assets/brand/logo-original.png"
    ],
    "artifactName": "DEINE-WAHL-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "nsis": {
      "createDesktopShortcut": "always",
      "shortcutName": "DEINE WAHL"
    },
    "win": {
      "icon": "icon.ico"
    },
    "portable": {
      "artifactName": "DEINE-WAHL-Portable.exe"
    }
  },
  "license": "MIT"
}
